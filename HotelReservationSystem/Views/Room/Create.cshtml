@model HotelReservationSystem.Models.Room

@{
    ViewData["Title"] = "Add Room";
}

<h1>Add Room</h1>

<form asp-controller="Room" asp-action="Create" method="post" class="form-container">
    <div class="form-group">
        <label asp-for="RoomNumber">Room Number</label>
        <input asp-for="RoomNumber" />
        <span asp-validation-for="RoomNumber" class="validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="RoomType">Room Type</label>
        <select asp-for="RoomType">
            <option value="">Select room type</option>
            <option value="Single">Single</option>
            <option value="Double">Double</option>
            <option value="Apartment">Apartment</option>
            <option value="Suite">Suite</option>
        </select>
        <span asp-validation-for="RoomType" class="validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="PricePerNight">Price per Night</label>
        <input asp-for="PricePerNight" type="number" step="0.01" />
        <span asp-validation-for="PricePerNight" class="validation-error"></span>
    </div>

    <button type="submit" class="btn">Save Room</button>
    <a class="btn secondary" asp-controller="Room" asp-action="Index">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}